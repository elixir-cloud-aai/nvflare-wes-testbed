# Deny by default: only what the images need goes into the build context.
# No site data, no secrets.
*
!wes/*.py
!images/*.sh
!testset/job
!testset/job_src/*.py
!testset/evaluate.py
!tests/*.py
!tests/*.sh

# Also not within the included paths: local secrets, startup kits, caches
**/.env*
**/*.key
**/*.pem
**/*.csv
**/kits
**/__pycache__
**/*.py[cod]
