# One image for the FL server, the FL clients, the simulator and the thin WES.
# Sandbox only. Holds no startup kits, keys or site data: those come in at run
# time, and the job in the image has no data in it.
FROM python:3.12-slim@sha256:b18b261e1b4974b4f321451ad5251ded85abb22c2b8b262da527dda1d031ab30
RUN pip install --no-cache-dir \
    "nvflare==2.9.0" \
    "numpy>=1.26,<3" \
    "fastapi>=0.115,<1" \
    "python-multipart>=0.0.9,<1" \
    "uvicorn>=0.30,<1" \
    "requests>=2.32,<3"
COPY images/fl-client.sh /usr/local/bin/fl-client
COPY images/fl-server.sh /usr/local/bin/fl-server
COPY wes /app/wes
COPY testset/job /app/testset/job
COPY testset/job_src /app/testset/job_src
COPY testset/evaluate.py /app/testset/evaluate.py
COPY tests /app/tests
# Readable by any user, as nodes and OpenShift may run tasks as an arbitrary one
RUN chmod 0755 /usr/local/bin/fl-client /usr/local/bin/fl-server && chmod -R a+rX /app
WORKDIR /app
