# One image for the FL server, the FL clients, the simulator and the thin WES.
# Sandbox only. Holds no startup kits, keys or site data: those come in at run
# time, and the job in the image has no data in it.
FROM python:3.12-slim@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b
# Upgrades the packages of the base image, whose fixes may not be in it yet,
# as the scan of the release image (`release.yml`) fails on fixable critical
# and high vulnerabilities
RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && apt-get install -y curl \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir \
        "nvflare==2.9.0" \
        "numpy>=1.26,<3" \
        "fastapi>=0.115,<1" \
        "python-multipart>=0.0.9,<1" \
        "uvicorn>=0.30,<1" \
        "requests>=2.32,<3" \
        "pyjwt[crypto]>=2.9,<3"
# The package's metadata alone (it has no modules), so that the WES reports the
# version of `pyproject.toml` in its service info
COPY pyproject.toml README.md LICENSE /tmp/package/
RUN pip install --no-cache-dir --no-deps /tmp/package && rm -rf /tmp/package
COPY images/fl-client.sh /usr/local/bin/fl-client
COPY images/fl-server.sh /usr/local/bin/fl-server
COPY wes /app/wes
COPY testset/job /app/testset/job
COPY testset/job_src /app/testset/job_src
COPY testset/evaluate.py /app/testset/evaluate.py
COPY testset/fedavg /app/testset/fedavg
COPY tests /app/tests
# Readable by any user, as nodes and OpenShift may run tasks as an arbitrary one
RUN chmod 0755 /usr/local/bin/fl-client /usr/local/bin/fl-server && chmod -R a+rX /app
WORKDIR /app
