{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "hubName", "kitsHost", "flPort", "flScheme", "sitesSecret"],
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {
          "description": "A sha-<commit> tag of dev, as dev moves",
          "type": "string",
          "pattern": "^sha-[0-9a-f]{40}$"
        },
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "hubName": {
      "description": "Public name of the hub, with an A record to the LoadBalancer; not under rahtiapp.fi",
      "type": "string",
      "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$",
      "not": {"pattern": "(^|\\.)rahtiapp\\.fi$"}
    },
    "kitsHost": {
      "description": "Name of the Route for /kits, without a scheme, under rahtiapp.fi, which the router's certificate covers",
      "type": "string",
      "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+rahtiapp\\.fi$"
    },
    "flPort": {
      "description": "FL port: Rahti's LoadBalancer ports are 30000 to 35000",
      "type": "integer",
      "minimum": 30000,
      "maximum": 35000
    },
    "flScheme": {"type": "string", "enum": ["grpc", "http"]},
    "loadBalancerIP": {
      "description": "Internal IPv4 address of the project's pool (not the public one), or empty",
      "type": "string",
      "pattern": "^$|^((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$"
    },
    "sitesSecret": {"type": "string", "minLength": 1},
    "resources": {"type": "object"}
  }
}
